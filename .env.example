# ---------- Embedding (local, CPU-only) ----------
# 384 dimensions, roughly ten times faster than bge-large on CPU, which is what
# makes embedding the candidates at query time viable.
SPS_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
SPS_EMBEDDING_DIM=384
SPS_EMBEDDING_DEVICE=cpu
SPS_EMBEDDING_ENCODE_BATCH=16
SPS_USE_BGE_QUERY_INSTRUCTION=true

# ---------- Retrieval ----------
# Calibrated for bge-small, which scores systematically higher than bge-large:
# a materially different defect reaches 0.8442 against 0.7831. See "Threshold:
# recalibrate for bge-small" in the README. Override per run with --threshold.
SPS_CONFIDENCE_THRESHOLD=0.89

# ---------- Generation ----------
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
# 2024-10-21 is the first GA version with json_schema structured outputs; older
# versions silently fall back to JSON mode plus client-side validation.
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=gpt-4o
SPS_LLM_TEMPERATURE=0.0
SPS_LLM_TOP_P=0.1
SPS_MAX_ATTEMPTS=3
SPS_LLM_TIMEOUT=60
