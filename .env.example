# ---------- Embedding (local, CPU-only) ----------
SPS_EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
SPS_EMBEDDING_DIM=1024
SPS_EMBEDDING_DEVICE=cpu
SPS_EMBEDDING_ENCODE_BATCH=16
SPS_USE_BGE_QUERY_INSTRUCTION=true

# ---------- Component A: indexing ----------
SPS_INDEX_BATCH_SIZE=400
SPS_SOURCE_DSN=mssql+pyodbc://user:pass@host/SPSDB?driver=ODBC+Driver+18+for+SQL+Server
SPS_SOURCE_TABLE=dbo.SupplierProblemSheet
SPS_WATERMARK_PATH=./state/watermark.json
SPS_MIN_TEXT_LENGTH=15

# ---------- Vector DB ----------
# Embedded mode: Qdrant runs in-process against this directory. No Docker, no
# Windows service. It takes an EXCLUSIVE lock, so the indexer and the Performer
# must never run at the same time -- the UiPath schedule guarantees that.
# Set this and SPS_QDRANT_URL is ignored.
SPS_QDRANT_PATH=./qdrant_data
SPS_COLLECTION=sps_problems

# Server mode (leave SPS_QDRANT_PATH empty to use these instead):
SPS_QDRANT_URL=http://localhost:6333
SPS_QDRANT_API_KEY=

# ---------- Component B: retrieval ----------
SPS_TOP_K=15
SPS_MIN_QUERY_LENGTH=10
SPS_MAX_CONTEXT_RECORDS=15

# Spec default is 0.75. Measured against the real BGE space, 0.75 admits
# semantically adjacent but materially different defects (see "Threshold
# calibration" in the README). 0.82 is the interim value pending eval-set
# tuning; the Justification text follows whatever is set here.
SPS_CONFIDENCE_THRESHOLD=0.82

# ---------- Component C: generation ----------
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
# 2024-10-21 is the first GA version supporting json_schema structured
# outputs. Older versions silently fall back to JSON mode + client-side
# validation, which still works but is one guarantee weaker.
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=gpt-4o
SPS_LLM_TEMPERATURE=0.0
SPS_LLM_TOP_P=0.1
SPS_MAX_ATTEMPTS=3
SPS_LLM_TIMEOUT=60
