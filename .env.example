# Copy to .env and fill in. Save it as UTF-8, which is what Notepad writes.
# Real environment variables always win over this file.

# ---------- Embedding: Azure (the only encoder) ----------
# A separate deployment from the chat model, with its own endpoint and key, so
# one can fail or be rotated without touching the other.
#
# REQUIRED. There is no other encoder, so all three of these must be set or no
# ticket can be resolved at all. Missing values exit 2 (fix the configuration);
# a transient failure exits 1 (retry).
AZURE_EMBEDDING_ENDPOINT=https://<resource>.openai.azure.com/
AZURE_EMBEDDING_API_KEY=
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AZURE_EMBEDDING_API_VERSION=2024-10-21
# Shorter than the chat timeout on purpose: an embedding request is small, so
# one this slow has stalled, and failing it as transient (exit 1, retried) beats
# waiting out a full minute first.
AZURE_EMBEDDING_TIMEOUT=20

# ---------- Tier 1: intent matching ----------
# Tier 1 does not write recommendations. It reads the shortlisted records, asks
# which of them is making the same REQUEST as the ticket, and at or above this
# score it sends that record's solution to the supplier EXACTLY AS RECORDED --
# no rewrite, no audit, no compliance loop.
#
# Which makes this the only decision in the Tier-1 path, and worth stating
# plainly: raising it means fewer answers, lowering it means more archive text
# reaching suppliers unedited. The Cascade_Warnings column names what is in a
# cascaded solution; it warns, it does not stop.
#
# 0.75 is PROVISIONAL for a reason peculiar to this number: it is an LLM's
# score, not a cosine, and an LLM's "82%" is not a calibrated probability. It
# ranks five candidates against each other reliably; read as an absolute gate
# it means whatever the model decides it means. Judge it on labelled cases with
# `python sps.py eval` -- its Status column shows which ones it passed -- before
# treating it as settled.
SPS_INTENT_THRESHOLD=0.75

# How many records the scorer is shown: the best by cosine, after the recall
# gate below. It reads all of them in one prompt and has to tell them apart,
# so a shorter list is a sharper judgement. Up to three that clear the intent
# threshold are sent, each on its own row, so keep this at 3 or more.
SPS_INTENT_TOP_K=5

# ---------- Tier 1: commodity families ----------
# A ticket is matched against its part's whole commodity family -- every part
# whose code (the part number up to its first hyphen) shares a group -- per this
# file: .csv or .xlsx, columns Commodity_Code and Group, one row per code. Empty
# means each ticket is matched on its own part number only, and its Reason says
# so. Use an absolute path; save as CSV, or format the code column as Text, so
# Excel cannot turn 0011 into 11.
SPS_COMMODITY_GROUPS=

# ---------- Tier 1: the history store ----------
# Where the local SQLite mirror of the history lives. Empty means beside the
# history file. LOCAL DISK ONLY: SQLite's locking cannot be trusted over a
# network share, so a store that would land on one goes under %LOCALAPPDATA%
# instead. Robots and `python sps.py ingest` must see the same setting to share
# one store.
SPS_HISTORY_STORE_DIR=
# sqlite (default), or memory: no store, the history read and embedded every run.
SPS_HISTORY_STORE=sqlite

# ---------- Retrieval ----------
# A threshold belongs to ONE embedding space and does not survive a change of
# model. The default lives in sps.py beside the retriever; these variables only
# override it.
#
# This is now a RECALL FILTER, not a decision. It used to decide whether a
# ticket got an answer; the intent scorer decides that now, so this was lowered
# from 0.50 to 0.30 and its job changed.
#
# Setting it high is the mistake to avoid. Two gates in series -- a cosine here
# and an intent score above -- means this one quietly does half the deciding: a
# record whose intent matches perfectly but whose WORDING scores below it is
# discarded before the scorer ever sees it, and nothing reports that it
# happened. Wording similarity is exactly the judgement this design moved away
# from making. Admit generously and let the scorer reject.
#
# `python sps.py check --probe` measures the distribution.
AZURE_EMBEDDING_THRESHOLD=0.30

# Overrides AZURE_EMBEDDING_THRESHOLD when set, and --threshold overrides this.
# Tier 1 only -- see SPS_TIER2_THRESHOLD below.
SPS_CONFIDENCE_THRESHOLD=

# ---------- Tier 2: the 0250 engineering standards ----------
# WHICH TICKETS MAY REACH TIER 2 AT ALL. Comma-separated Problem_Reason_Code
# values; matching ignores case and surrounding spaces. Add or remove codes
# here without touching code.
#
# EMPTY MEANS TIER 2 NEVER RUNS. That is deliberate -- the standards are scoped
# to particular reason codes, so an unset list is read as "none configured"
# rather than "all of them". The cost is that losing this line disables Tier 2
# across the whole deployment, so the resolver reports the two cases in
# different words: "no reason codes are configured" is a deployment fault,
# "reason code X is not one of the N configured" is routine.
SPS_TIER2_REASON_CODES=
# Where the .docx standards live. Tier 2 runs only when this folder holds at
# least one .docx; an empty folder means every ticket reports its Tier-1
# outcome, exactly as before Tier 2 existed. Legacy .doc files are skipped with
# a warning -- reading one needs Word via COM, which hangs a headless robot.
SPS_0250_DOCS_DIR=data/0250_docs

# Tier 2 has its own threshold, and this is not a detail. Tier 1 compares one
# short defect sentence against another; Tier 2 compares a defect sentence
# against 300 words of standards prose that answers it without resembling it.
# It is PROVISIONAL twice over: Tier 1's former Azure figure, itself
# unmeasured, scaled by the Tier-1:Tier-2 ratio measured on the since-removed
# local model. `python sps.py check` reads it against a real standards passage
# and suggests a range.
TIER2_AZURE_THRESHOLD=0.35

# Overrides TIER2_AZURE_THRESHOLD when set, and --tier2-threshold overrides
# this. Separate from SPS_CONFIDENCE_THRESHOLD because one value standing for
# two different comparisons is meaningless.
SPS_TIER2_THRESHOLD=

# ---------- Generation ----------
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
# 2024-10-21 is the first GA version with json_schema structured outputs; older
# versions silently fall back to JSON mode plus client-side validation.
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=gpt-4o
SPS_LLM_TEMPERATURE=0.0
SPS_LLM_TOP_P=0.1
SPS_MAX_ATTEMPTS=3
SPS_LLM_TIMEOUT=60
