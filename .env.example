# ---------- Embedding: Azure (the only encoder) ----------
# A separate deployment from the chat model, with its own endpoint and key, so
# one can fail or be rotated without touching the other.
#
# REQUIRED. The local bge-small fallback is disabled, so all three of these must
# be set or no ticket can be resolved at all. Missing values exit 2 (fix the
# configuration); a transient failure exits 1 (retry).
AZURE_EMBEDDING_ENDPOINT=https://<resource>.openai.azure.com/
AZURE_EMBEDDING_API_KEY=
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_EMBEDDING_API_VERSION=2024-10-21
# Shorter than the chat timeout on purpose: a slow embedding call has a working
# alternative one exception away, so waiting a full minute to find that out
# costs more than it saves.
AZURE_EMBEDDING_TIMEOUT=20

# ---------- Embedding: local model (DISABLED) ----------
# Out of the pipeline. Nothing reads these at present -- the wrapper still
# exists in sps/embedding.py and `python -m scripts.verify_embedder --local`
# still exercises it, but no retriever reaches it and requirements.txt no
# longer installs torch or sentence-transformers. Left here so re-enabling is
# uncommenting rather than rediscovering.
SPS_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
SPS_EMBEDDING_DIM=384
SPS_EMBEDDING_DEVICE=cpu
SPS_EMBEDDING_ENCODE_BATCH=16
SPS_USE_BGE_QUERY_INSTRUCTION=true

# ---------- Tier 1: intent matching ----------
# Tier 1 does not write recommendations. It reads the shortlisted records, asks
# which of them is making the same REQUEST as the ticket, and at or above this
# score it sends that record's solution to the supplier EXACTLY AS RECORDED --
# no rewrite, no audit, no compliance loop.
#
# Which makes this the only decision in the Tier-1 path, and worth stating
# plainly: raising it means fewer answers, lowering it means more archive text
# reaching suppliers unedited. The Cascade_Warnings column names what is in a
# cascaded solution; it warns, it does not stop.
#
# 0.75 is PROVISIONAL for a reason peculiar to this number: it is an LLM's
# score, not a cosine, and an LLM's "82%" is not a calibrated probability. It
# ranks five candidates against each other reliably; read as an absolute gate
# it means whatever the model decides it means. Measure with
# `python -m scripts.run_eval_batch` before treating it as settled.
SPS_INTENT_THRESHOLD=0.75

# How many records the scorer is shown. It reads all of them in one prompt and
# has to tell them apart, so a shorter list is a sharper judgement.
SPS_INTENT_TOP_K=5

# ---------- Retrieval ----------
# A threshold belongs to ONE embedding space and does not survive a change of
# model, so there is one per encoder and the gate applies whichever actually
# produced the vectors. Both live in sps/retrieval/in_memory.py beside the
# engine; these variables only override them.
#
# AZURE is the one that applies, and it is now a RECALL FILTER, not a decision.
# It used to decide whether a ticket got an answer; the intent scorer decides
# that now, so this was lowered from 0.50 to 0.30 and its job changed.
#
# Setting it high is the mistake to avoid. Two gates in series -- a cosine here
# and an intent score above -- means this one quietly does half the deciding: a
# record whose intent matches perfectly but whose WORDING scores below it is
# discarded before the scorer ever sees it, and nothing reports that it
# happened. Wording similarity is exactly the judgement this design moved away
# from making. Admit generously and let the scorer reject.
#
# `python -m scripts.verify_embedder --probe` measures the distribution.
#
# LOCAL is dormant while the local model is out of the pipeline. 0.89 was
# measured against bge-small and is kept so re-enabling is a wiring change, not
# a re-measurement. Note it has NOT been re-tuned as a recall filter.
AZURE_EMBEDDING_THRESHOLD=0.30
LOCAL_EMBEDDING_THRESHOLD=0.89

# Overrides BOTH of the above when set. Leave empty to let the backend decide.
# Tier 1 only -- see SPS_TIER2_THRESHOLD below.
SPS_CONFIDENCE_THRESHOLD=

# ---------- Tier 2: the 0250 engineering standards ----------
# WHICH TICKETS MAY REACH TIER 2 AT ALL. Comma-separated Problem_Reason_Code
# values; matching ignores case and surrounding spaces. Add or remove codes
# here without touching code.
#
# EMPTY MEANS TIER 2 NEVER RUNS. That is deliberate -- the standards are scoped
# to particular reason codes, so an unset list is read as "none configured"
# rather than "all of them". The cost is that losing this line disables Tier 2
# across the whole deployment, so the resolver reports the two cases in
# different words: "no reason codes are configured" is a deployment fault,
# "reason code X is not one of the N configured" is routine.
SPS_TIER2_REASON_CODES=
# Where the .docx standards live. Tier 2 runs only when this folder holds at
# least one .docx; an empty folder means every ticket reports its Tier-1
# outcome, exactly as before Tier 2 existed. Legacy .doc files are skipped with
# a warning -- reading one needs Word via COM, which hangs a headless robot.
SPS_0250_DOCS_DIR=data/0250_docs

# Tier 2 has its own thresholds, and this is not a detail. Tier 1 compares one
# short defect sentence against another; Tier 2 compares a defect sentence
# against 300 words of standards prose that answers it without resembling it.
# TIER2_AZURE is the one that applies, and it is PROVISIONAL twice over:
# derived from the Azure Tier-1 figure, which is itself unmeasured, scaled by
# the ratio measured on the local model. `verify_embedder` reads it against a
# real standards passage and suggests a range.
TIER2_AZURE_THRESHOLD=0.35

# Dormant, like LOCAL_EMBEDDING_THRESHOLD. Measured with bge-small on the demo
# corpus: the section that answers the ticket scores 0.75-0.81, while a defect
# the corpus does not cover peaks at 0.5944 -- which is why Tier 2 needs its own
# number at all, Tier 1's 0.89 having rejected every chunk.
TIER2_LOCAL_THRESHOLD=0.62

# Overrides both of the Tier-2 numbers. Separate from SPS_CONFIDENCE_THRESHOLD
# because one value standing for two different embedding spaces is meaningless.
SPS_TIER2_THRESHOLD=

# ---------- Generation ----------
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
# 2024-10-21 is the first GA version with json_schema structured outputs; older
# versions silently fall back to JSON mode plus client-side validation.
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=gpt-4o
SPS_LLM_TEMPERATURE=0.0
SPS_LLM_TOP_P=0.1
SPS_MAX_ATTEMPTS=3
SPS_LLM_TIMEOUT=60
